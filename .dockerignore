# SPDX-License-Identifier: GPL-3.0-or-later
#
# Docker build context exclusions.
#
# The Dockerfile only needs the sources listed below; everything else
# (Zephyr modules, bootloader, build artifacts, git metadata) is excluded
# to keep the build context small and fast.

# Git
.git
.gitignore

# Build artifacts
build/
*.bin
*.elf
*.map

# Zephyr / west
.west/
zephyr/
modules/
bootloader/
tools/

# Third-party submodules — excluded by default, but the demo Makefile needs
# quirc to build the qr_decode WASM module. Because Docker cannot re-include
# a path whose parent is excluded, we exclude the children with `external/*`
# and then re-include the ones the build needs.
external/*
!external/quirc/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store

# Tests (not needed for the WASM image)
tests/

# Documentation (only doc/img/relic-logo_icone.svg is needed, copied explicitly)
doc/commands.md
CONTRIBUTING.md
doc/img/split.PNG
doc/img/unsplit.PNG
doc/img/success_flashing.PNG

