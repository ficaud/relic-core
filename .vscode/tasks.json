{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (esp32s3_devkitc/procpu)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "west build -b esp32s3_devkitc/esp32s3/procpu -d build-esp32s3 . && ln -sfn \"${workspaceFolder}/build-esp32s3/compile_commands.json\" \"${workspaceFolder}/compile_commands.json\""
            ],
            "options": {
                "env": {
                    "ZEPHYR_BASE": "${workspaceFolder}/zephyr",
                    "ZEPHYR_SDK_INSTALL_DIR": "/opt/zephyr-sdk"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "clear": true
            }
        },
        {
