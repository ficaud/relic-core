        },
        {
            "label": "Build & Run Unit Tests",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "cmake -S . -B build-tests -DBUILD_TESTS=ON && cmake --build build-tests && ctest --test-dir build-tests --output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "clear": true
            }
        },
        {
            "label": "Flash ESP32-S3 via JTAG (RPi)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/flash-esp32s3-jtag.sh"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "clear": true
            }
        },
        {
            "label": "Build Demo WASM (Makefile)",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "demo",
                "clean",
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "clear": true
            }
        }
   ]
