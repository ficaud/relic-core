#
# clangd configuration for the native unit tests.
#
# The tests are built natively (not for the ESP32), so they use their own
# compile_commands.json generated by the "tests" CMake preset in build/tests/.
# This file overrides the root .clangd so clangd parses the test sources
# with the correct native toolchain.

CompileFlags:
  CompilationDatabase: ../build/tests

