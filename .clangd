# SPDX-License-Identifier: GPL-3.0-or-later
#
# clangd configuration for Relic Core.
#
# Points clangd to the compile_commands.json generated by the Zephyr build.
# The build directory is created by `west build` (default) or by the
# CMakePresets.json presets.
#
# Zephyr uses the Xtensa ESP32 toolchain (xtensa-espressif_esp32_zephyr-elf-gcc)
# which clangd does not support. We therefore:
#   - Override the target triple to the host architecture so clangd can parse.
#   - Remove GCC-specific flags that clang does not understand.

CompileFlags:
  CompilationDatabase: .
  Add:
    - "--target=aarch64-unknown-linux-gnu"
    # Ensure clangd can always resolve Zephyr headers even when the Xtensa
    # toolchain (unknown to clangd) prevents it from applying the -I paths
    # from compile_commands.json.
    - "-I/workspaces/relic-core/zephyr/include"
    - "-I/workspaces/relic-core/build-esp32s3/zephyr/include/generated"
    - "-I/workspaces/relic-core/build-esp32s3/zephyr/include/generated/zephyr"
    - "-I/workspaces/relic-core/zephyr/lib/libc/picolibc/include"
    - "-I/workspaces/relic-core/zephyr/lib/libc/common/include"
    # Relic Core's own include dirs that aren't part of the firmware build but are
    # referenced by demo-only / portable sources. qr_decode.c lives in
    # src/qrcode/ and is compiled only by the demo Makefile, so its quirc
    # include path is not present in the firmware compile_commands.json.
    - "-I/workspaces/relic-core/src/qrcode"
    - "-I/workspaces/relic-core/external/quirc/lib"
  Remove:
    - "-mlongcalls"
    - "-fno-printf-return-value"
    - "-fno-reorder-functions"
    - "-fstrict-volatile-bitfields"
    # The Xtensa sysroot headers are incompatible with the host target clangd
    # uses; drop it so clangd falls back to its own system headers.
    - "--sysroot"

